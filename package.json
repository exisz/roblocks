{
  "name": "roblocks",
  "version": "0.0.3",
  "description": "Distributed credential vault with git-backed storage for distributed agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "roblocks": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format cjs --dts --clean",
    "dev": "tsup src/cli.ts src/index.ts --format cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "publish:patch": "npm version patch && pnpm build && npm publish --access public",
    "publish:minor": "npm version minor && pnpm build && npm publish --access public"
  },
  "keywords": [
    "credentials",
    "vault",
    "secrets",
    "git",
    "cli",
    "agents",
    "yaml"
  ],
  "author": "exisz <zheng@exis.academy>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exisz/roblocks.git"
  },
  "bugs": {
    "url": "https://github.com/exisz/roblocks/issues"
  },
  "homepage": "https://github.com/exisz/roblocks#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
